<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Skia 不解码 TIFF；使用带像素上限的纯托管解码器保留原图并生成缩略图。 -->
    <PackageReference Include="BitMiracle.LibTiff.NET" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- 2.1.12 carries SQLite >= 3.50.2 and replaces the vulnerable 2.1.11 transitively requested by Microsoft.Data.Sqlite 10.0.10. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- Avalonia already carries this version; Infrastructure uses it only for bounded background thumbnail generation. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnapBoard.Application\SnapBoard.Application.csproj" />
    <ProjectReference Include="..\SnapBoard.Domain\SnapBoard.Domain.csproj" />
    <ProjectReference Include="..\SnapBoard.Sync.Contracts\SnapBoard.Sync.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
