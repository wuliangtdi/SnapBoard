<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="SnapBoard.Desktop.Views.StorageMigrationConfirmationWindow"
        Width="500"
        Height="340"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/snapboard-app-icon.png"
        WindowStartupLocation="CenterOwner"
        Title="确认迁移本地数据">
    <Grid RowDefinitions="64,*,72">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0" ColumnDefinitions="Auto,*" ColumnSpacing="11">
                <Border Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        CornerRadius="6"
                        Background="{DynamicResource SelectionSurfaceBrush}">
                    <materialIcons:MaterialIcon Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Kind="FolderMoveOutline" />
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="迁移本地数据" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="请确认新的存储位置" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="24,19,24,18"
              RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="迁移会关闭闪剪，将当前数据完整复制到新位置并校验。完成后应用会自动重新启动。"
                       TextWrapping="Wrap" />

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="12,10"
                    Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="目标目录" />
                    <TextBlock x:Name="TargetDirectoryText"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="MigrationDetailsText"
                       Grid.Row="2"
                       Margin="0,11,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="3"
                       Margin="0,7,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="为保护已有文件，只能迁移到空目录；闪剪不会覆盖目标目录中的其他数据。"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="22,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Button x:Name="CancelButton"
                        Classes="secondary-command"
                        Click="OnCancelClicked"
                        Content="取消" />
                <Button x:Name="ConfirmButton"
                        Classes="primary-command"
                        Click="OnConfirmClicked">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <materialIcons:MaterialIcon Width="17"
                                                    Height="17"
                                                    Kind="SwapHorizontalBold" />
                        <TextBlock VerticalAlignment="Center" Text="退出并迁移" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
