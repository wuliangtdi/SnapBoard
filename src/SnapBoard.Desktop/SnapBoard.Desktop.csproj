<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\snapboard.ico</ApplicationIcon>
    <AssemblyTitle>闪剪</AssemblyTitle>
    <Product>闪剪</Product>
    <Description>闪剪</Description>
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishTrimmed Condition="'$(PublishAot)' == 'true'">true</PublishTrimmed>
    <TrimMode Condition="'$(PublishAot)' == 'true'">full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnapBoard.Application\SnapBoard.Application.csproj" />
    <ProjectReference Include="..\SnapBoard.Domain\SnapBoard.Domain.csproj" />
    <ProjectReference Include="..\SnapBoard.Infrastructure\SnapBoard.Infrastructure.csproj" />
    <ProjectReference Include="..\SnapBoard.Platform.Abstractions\SnapBoard.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\SnapBoard.Platform.MacOS\SnapBoard.Platform.MacOS.csproj" />
    <ProjectReference Include="..\SnapBoard.Platform.Windows\SnapBoard.Platform.Windows.csproj" />
    <ProjectReference Include="..\SnapBoard.StorageMigrator\SnapBoard.StorageMigrator.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SnapBoard.Sync.Contracts\SnapBoard.Sync.Contracts.csproj" />
    <ProjectReference Include="..\SnapBoard.Sync.WebDav\SnapBoard.Sync.WebDav.csproj" />
  </ItemGroup>

  <Target Name="CopyStorageMigratorForBuild"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_StorageMigratorBuildExecutableName Condition="$([MSBuild]::IsOSPlatform('Windows'))">SnapBoard.StorageMigrator.exe</_StorageMigratorBuildExecutableName>
      <_StorageMigratorBuildExecutableName Condition="'$(_StorageMigratorBuildExecutableName)' == ''">SnapBoard.StorageMigrator</_StorageMigratorBuildExecutableName>
      <_StorageMigratorBuildDirectory>$(MSBuildThisFileDirectory)../SnapBoard.StorageMigrator/bin/$(Configuration)/net10.0/</_StorageMigratorBuildDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_StorageMigratorBuildFiles Include="$(_StorageMigratorBuildDirectory)$(_StorageMigratorBuildExecutableName)" />
      <_StorageMigratorBuildFiles Include="$(_StorageMigratorBuildDirectory)SnapBoard.StorageMigrator.dll" />
      <_StorageMigratorBuildFiles Include="$(_StorageMigratorBuildDirectory)SnapBoard.StorageMigrator.deps.json" />
      <_StorageMigratorBuildFiles Include="$(_StorageMigratorBuildDirectory)SnapBoard.StorageMigrator.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_StorageMigratorBuildFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishNativeStorageMigrator"
          AfterTargets="Publish"
          Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <PropertyGroup>
      <_StorageMigratorIntermediateRelative>$(IntermediateOutputPath)storage-migrator-publish/</_StorageMigratorIntermediateRelative>
      <_StorageMigratorPublishDirectory>$([System.IO.Path]::GetFullPath('$(_StorageMigratorIntermediateRelative)', '$(MSBuildProjectDirectory)'))</_StorageMigratorPublishDirectory>
      <_StorageMigratorPublishExecutableName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">SnapBoard.StorageMigrator.exe</_StorageMigratorPublishExecutableName>
      <_StorageMigratorPublishExecutableName Condition="'$(_StorageMigratorPublishExecutableName)' == ''">SnapBoard.StorageMigrator</_StorageMigratorPublishExecutableName>
    </PropertyGroup>
    <RemoveDir Directories="$(_StorageMigratorPublishDirectory)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SnapBoard.StorageMigrator\SnapBoard.StorageMigrator.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishAot=true;PublishDir=$(_StorageMigratorPublishDirectory)/" />
    <Error Condition="!Exists('$(_StorageMigratorPublishDirectory)/$(_StorageMigratorPublishExecutableName)')"
           Text="The matching Native AOT storage migrator was not produced." />
    <Error Condition="Exists('$(_StorageMigratorPublishDirectory)/SnapBoard.StorageMigrator.dll') Or Exists('$(_StorageMigratorPublishDirectory)/SnapBoard.StorageMigrator.deps.json') Or Exists('$(_StorageMigratorPublishDirectory)/SnapBoard.StorageMigrator.runtimeconfig.json')"
           Text="The storage migrator publish contains framework-dependent artifacts." />
    <ItemGroup>
      <_ObsoleteStorageMigratorPublishFiles Include="$(PublishDir)SnapBoard.StorageMigrator.dll" />
      <_ObsoleteStorageMigratorPublishFiles Include="$(PublishDir)SnapBoard.StorageMigrator.deps.json" />
      <_ObsoleteStorageMigratorPublishFiles Include="$(PublishDir)SnapBoard.StorageMigrator.runtimeconfig.json" />
      <_ObsoleteStorageMigratorPublishFiles Include="$(PublishDir)SnapBoard.StorageMigrator.exe"
                                             Condition="'$(_StorageMigratorPublishExecutableName)' != 'SnapBoard.StorageMigrator.exe'" />
      <_ObsoleteStorageMigratorPublishFiles Include="$(PublishDir)SnapBoard.StorageMigrator"
                                             Condition="'$(_StorageMigratorPublishExecutableName)' != 'SnapBoard.StorageMigrator'" />
    </ItemGroup>
    <Delete Files="@(_ObsoleteStorageMigratorPublishFiles)" />
    <Copy SourceFiles="$(_StorageMigratorPublishDirectory)/$(_StorageMigratorPublishExecutableName)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)$(_StorageMigratorPublishExecutableName)')"
           Text="The Native AOT storage migrator is missing from the Desktop publish output." />
  </Target>
</Project>
