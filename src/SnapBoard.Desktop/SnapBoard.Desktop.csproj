<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\snapboard.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishTrimmed Condition="'$(PublishAot)' == 'true'">true</PublishTrimmed>
    <TrimMode Condition="'$(PublishAot)' == 'true'">full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnapBoard.Application\SnapBoard.Application.csproj" />
    <ProjectReference Include="..\SnapBoard.Domain\SnapBoard.Domain.csproj" />
    <ProjectReference Include="..\SnapBoard.Infrastructure\SnapBoard.Infrastructure.csproj" />
    <ProjectReference Include="..\SnapBoard.Platform.Abstractions\SnapBoard.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\SnapBoard.Platform.MacOS\SnapBoard.Platform.MacOS.csproj" />
    <ProjectReference Include="..\SnapBoard.Platform.Windows\SnapBoard.Platform.Windows.csproj" />
    <ProjectReference Include="..\SnapBoard.StorageMigrator\SnapBoard.StorageMigrator.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SnapBoard.Sync.Contracts\SnapBoard.Sync.Contracts.csproj" />
    <ProjectReference Include="..\SnapBoard.Sync.WebDav\SnapBoard.Sync.WebDav.csproj" />
  </ItemGroup>

  <Target Name="CopyStorageMigratorForBuild"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == '' and Exists('$(MSBuildThisFileDirectory)..\SnapBoard.StorageMigrator\bin\$(Configuration)\net10.0\SnapBoard.StorageMigrator.exe')">
    <ItemGroup>
      <_StorageMigratorBuildFiles Include="$(MSBuildThisFileDirectory)..\SnapBoard.StorageMigrator\bin\$(Configuration)\net10.0\SnapBoard.StorageMigrator.exe" />
      <_StorageMigratorBuildFiles Include="$(MSBuildThisFileDirectory)..\SnapBoard.StorageMigrator\bin\$(Configuration)\net10.0\SnapBoard.StorageMigrator.deps.json" />
      <_StorageMigratorBuildFiles Include="$(MSBuildThisFileDirectory)..\SnapBoard.StorageMigrator\bin\$(Configuration)\net10.0\SnapBoard.StorageMigrator.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_StorageMigratorBuildFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishNativeStorageMigrator"
          AfterTargets="Publish"
          Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
    <PropertyGroup>
      <_StorageMigratorPublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)storage-migrator-publish\'))</_StorageMigratorPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SnapBoard.StorageMigrator\SnapBoard.StorageMigrator.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishAot=true;PublishDir=$(_StorageMigratorPublishDirectory)" />
    <Copy SourceFiles="$(_StorageMigratorPublishDirectory)SnapBoard.StorageMigrator.exe"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_StorageMigratorFrameworkArtifacts Include="$(PublishDir)SnapBoard.StorageMigrator.deps.json" />
      <_StorageMigratorFrameworkArtifacts Include="$(PublishDir)SnapBoard.StorageMigrator.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(_StorageMigratorFrameworkArtifacts)" />
  </Target>
</Project>
